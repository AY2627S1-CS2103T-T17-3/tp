<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <HBox spacing="0.5" alignment="CENTER_LEFT">
        <TextField fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <!-- Ensures that the index is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </TextField>
        <TextField fx:id="name" text="\$first" styleClass="cell_big_label" />
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="7">
        <FlowPane fx:id="tags" />
        <TextField fx:id="status" styleClass="member_status" />
      </HBox>
      <TextField fx:id="phone" styleClass="cell_small_label" text="\$phone" />
      <TextField fx:id="address" styleClass="cell_small_label" text="\$address" />
      <TextField fx:id="email" styleClass="cell_small_label" text="\$email" />
    </VBox>
  </GridPane>
</HBox>
