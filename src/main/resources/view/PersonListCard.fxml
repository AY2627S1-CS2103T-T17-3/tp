<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" percentWidth="100" />
    </columnConstraints>
    <VBox alignment="TOP_LEFT" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <HBox spacing="0.5" alignment="TOP_LEFT">
        <Label fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <!-- Ensures that the label text is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="name" text="\$first" styleClass="cell_big_label" minWidth="0"
               maxWidth="Infinity" HBox.hgrow="ALWAYS" />
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="7">
        <FlowPane fx:id="tags" minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" />
        <Label fx:id="status" styleClass="member_status" minWidth="-Infinity" />
      </HBox>
      <Label fx:id="phone" styleClass="cell_small_label" text="\$phone" minWidth="0" maxWidth="Infinity" />
      <Label fx:id="address" styleClass="cell_small_label" text="\$address" minWidth="0"
             maxWidth="Infinity" wrapText="true" />
      <Label fx:id="email" styleClass="cell_small_label" text="\$email" minWidth="0" maxWidth="Infinity" />
    </VBox>
  </GridPane>
</HBox>
