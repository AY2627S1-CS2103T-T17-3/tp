<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <Region fx:id="statusStrip" styleClass="status-strip" minWidth="4" prefWidth="4" maxWidth="4"
          minHeight="0" prefHeight="0" maxHeight="Infinity" />
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" percentWidth="100" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <HBox spacing="0.5" alignment="CENTER_LEFT">
        <TextField fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <!-- Ensures that the index is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </TextField>
        <TextField fx:id="name" text="\$first" styleClass="cell_big_label" minWidth="0"
                   maxWidth="Infinity" HBox.hgrow="ALWAYS" />
      </HBox>
      <FlowPane fx:id="tags" minWidth="0" prefWidth="0" />
      <TextField fx:id="phone" styleClass="cell_small_label" text="\$phone" minWidth="0" maxWidth="Infinity" />
      <TextArea fx:id="address" styleClass="cell_small_label" text="\$address" minWidth="0"
                maxWidth="Infinity" wrapText="true" prefRowCount="3" />
      <TextField fx:id="email" styleClass="cell_small_label" text="\$email" minWidth="0" maxWidth="Infinity" />
    </VBox>
  </GridPane>
</HBox>
