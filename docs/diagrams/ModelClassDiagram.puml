@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ModelManager
enum StatusFilter {
ALL
ACTIVE
ARCHIVED
}
enum Status {
ACTIVE
ARCHIVED
}
Class UserPrefs

Class UniquePersonList
Class "FilteredList<Person>" as FilteredList
Class "<<interface>>\nPredicate<? super Person>" as SearchPredicate
Class Person
Class Address
Class Email
Class Name
Class Phone
Class Tag

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

AddressBook .up.|> ReadOnlyAddressBook

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyAddressBook
ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
ModelManager --> "1" StatusFilter : selected view
ModelManager --> "1" SearchPredicate : searchPredicate
ModelManager *--> "1" FilteredList : filteredPersons
UserPrefs .up.|> ReadOnlyUserPrefs

AddressBook *--> "1" UniquePersonList
UniquePersonList --> "~* all" Person
Person *--> Name
Person *--> Phone
Person *--> Email
Person *--> Address
Person --> "0..*" Tag : tags {unique}
Person --> "1" Status : status
FilteredList --> "~* visible" Person

note right of FilteredList
  Visible members match both
  searchPredicate and StatusFilter.
end note

note bottom of Tag
  Names normalized to lowercase
  using Locale.ROOT.
  Equality and hash codes use
  the normalized name.
  Within each member's Set<Tag>,
  case variants collapse to one tag.
end note

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> Email

@enduml
